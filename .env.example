# Node.js server only. The secret key must never be imported by client code,
# logged, committed, or renamed with a browser-exposed prefix.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# When the Vercel Supabase integration uses the custom prefix beaver, the app
# also accepts beaver_SUPABASE_URL and beaver_SUPABASE_SECRET_KEY.

# Server-side evaluation processing. The model is selected per run in the UI.
OPENROUTER_API_KEY=
# A manually prefixed Vercel variable named beaver_OPENROUTER_API_KEY is also
# accepted. The Supabase integration does not create an OpenRouter key.
OPENROUTER_SITE_URL=https://your-production-domain.example
OPENROUTER_APP_TITLE=BeaverMind Call Evaluation
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_MAX_TOKENS=16000
# Calls below this size use one direct evaluation request. Larger calls use
# turn-aligned evidence mapping before final scoring. These defaults favor
# recall and quality; lower map concurrency if your provider rate limit is low.
EVALUATION_LARGE_TRANSCRIPT_WORDS=6000
EVALUATION_CHUNK_WORDS=2400
EVALUATION_CHUNK_OVERLAP_TURNS=2
EVALUATION_MAP_CONCURRENCY=3
EVALUATION_WORKER_POLL_MS=2000
